# URL of the Python NLP service (cleaning + basic stats). Falls back to http://localhost:8000
NLP_SERVICE_URL=http://localhost:8000

# LLM provider API keys. Leave empty to run in demo mode (deterministic mock themes).
# Add one or more keys to unlock the corresponding provider in the configurator.

# Fireworks AI — supports seed for reproducible variation
FIREWORKS_API_KEY=

# OpenAI — supports seed for reproducible variation
OPENAI_API_KEY=

# Anthropic — does NOT support seed (reproducibility via temperature only)
ANTHROPIC_API_KEY=

# Google Gemini — does NOT support seed (reproducibility via temperature only)
GEMINI_API_KEY=

# OpenRouter — supports seed; unified access to Llama, Claude, DeepSeek, etc.
OPENROUTER_API_KEY=
